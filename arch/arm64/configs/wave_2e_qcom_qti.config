# SPDX-License-Identifier: GPL-2.0-only
# Sub-wave 2E qcom_qti — kernel-internal driver CONFIG flips.
# Each CONFIG here corresponds to a kernel-internal driver that
# OEM ships as a prebuilt .ko via tech-package overlay; we
# enable the CONFIG and add a corresponding obj-$() entry to
# the appropriate kernel Makefile (since OEM's overlay is
# unavailable to us).
#
# See WIRE_UP_RECIPE.md Step 7.8b for the OEM-techpack-overlay-coupled
# class signature and disposition framework.

# qcom_glink_spss: secure-side processor link via QTI Glink
# (drivers/rpmsg/qcom_glink_spss.c)
CONFIG_RPMSG_QCOM_GLINK_SPSS=m

# qcom_lpm: low-power management monitor (runtime-active)
# (drivers/soc/qcom/qcom_lpm_monitor.c +
#  qcom_lpm_monitor_service_v01.c)
CONFIG_QCOM_LPM_MONITOR=m

# qcom_spss: secure subsystem peripheral loading
# (drivers/remoteproc/qcom_spss.c)
CONFIG_QCOM_SPSS=m

# DEFERRED: qcom-vadc-common is a hidden tristate (Kconfig has
# no prompt string) that's `select`'d by other drivers, none
# of which are enabled in our tree. MFD_PM8XXX (which would
# select it) depends on ARM || HEXAGON; we're ARM64. Resolution
# requires either patching the Kconfig to expose a prompt or
# adding `select QCOM_VADC_COMMON` to a driver we control.
# Tracked for the Kconfig+Makefile batch (TBD).
# CONFIG_QCOM_VADC_COMMON=m

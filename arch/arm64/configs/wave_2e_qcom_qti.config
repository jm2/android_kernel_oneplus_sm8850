# SPDX-License-Identifier: GPL-2.0-only
# Sub-wave 2E qcom_qti — kernel-internal driver CONFIG flips.
# Each CONFIG here corresponds to a kernel-internal driver that
# OEM ships as a prebuilt .ko via tech-package overlay; we
# enable the CONFIG and add a corresponding obj-$() entry to
# the appropriate kernel Makefile (since OEM's overlay is
# unavailable to us).
#
# See WIRE_UP_RECIPE.md Step 7.8b for the OEM-techpack-overlay-coupled
# class signature and disposition framework.

# qcom_glink_spss: secure-side processor link via QTI Glink
# (drivers/rpmsg/qcom_glink_spss.c)
CONFIG_RPMSG_QCOM_GLINK_SPSS=m

# qcom_lpm: cpuidle LPM governor — multi-source bundle.
# (drivers/cpuidle/governors/qcom-lpm.c + qcom-cluster-lpm.c +
# qcom-lpm-sysfs.c). Authored new Kconfig file at
# drivers/cpuidle/governors/Kconfig (sourced from parent) and
# qcom_lpm-y multi-source rule in same dir's Makefile.
# Depends on CONFIG_SCHED_WALT=m (already set in canoe_perf).
CONFIG_CPU_IDLE_GOV_QCOM_LPM=m

# qcom_spss: secure subsystem peripheral loading
# (drivers/remoteproc/qcom_spss.c)
CONFIG_QCOM_SPSS=m

# qcom-vadc-common: PMIC VADC helper library.
# Was hidden tristate; added a prompt to drivers/iio/adc/Kconfig
# so the fragment can enable it directly. Selected by
# QCOM_SPMI_ADC5_GEN3 (below) for automatic enablement when an
# ADC consumer is built.
CONFIG_QCOM_VADC_COMMON=m

# qcom-spmi-adc5-gen3: PMIC5 Gen3 SPMI ADC driver.
# (drivers/iio/adc/qcom-spmi-adc5-gen3.c). New Kconfig stanza
# modeled on QCOM_SPMI_ADC5. Selects QCOM_VADC_COMMON.
CONFIG_QCOM_SPMI_ADC5_GEN3=m

# qcom-i2c-pmic: I2C-controlled QTI PMIC support.
# (drivers/mfd/qcom-i2c-pmic.c). Kconfig stanza MFD_I2C_PMIC
# already existed; only needed obj-$() Makefile entry.
CONFIG_MFD_I2C_PMIC=m

# qcom-amoled-regulator + debug-regulator (batch-2b, vendor-strip cascade
# per WIRE_UP_RECIPE Step 7.8e). qcom-amoled-regulator consumes
# regulator_debug_register / devm_regulator_debug_register from
# debug-regulator.ko; both Kconfig stanzas + Makefile entries were
# missing in our tree. Authored both. REGULATOR_QCOM_AMOLED selects
# REGULATOR_DEBUG_CONTROL so the dep gets pulled in automatically.
CONFIG_REGULATOR_QCOM_AMOLED=m
CONFIG_REGULATOR_DEBUG_CONTROL=m

# qcom-hv-haptics + qti_battery_charger (batch-2c, vendor-strip cascade).
# Initial assumption (qcom-hv-haptics needs oplus_chg_v2 → OEM-Bazel-coupled)
# was wrong: the actual hboost notifier register/unregister symbols
# (register_hboost_event_notifier, unregister_hboost_event_notifier) come
# from drivers/power/supply/qti_battery_charger.c (kernel-internal, also
# techpack-overlay-coupled per Step 7.8b). Both source-present, both
# Kconfig+Makefile-missing. Authored both. No synth_symvers bridge
# needed — pure 7.8b/7.8e treatment. CONFIGs are already =m in
# canoe_perf.config; listed here for batch-trail audit completeness.
CONFIG_QTI_BATTERY_CHARGER=m
CONFIG_INPUT_QCOM_HV_HAPTICS=m

# DEFERRED to dedicated sub-wave (qcom_lpm + SCHED_WALT cascade):
# qcom_lpm depends on SCHED_WALT, whose Kconfig isn't sourced in our
# tree and whose .ko bundles 24 source files + 4 OEM ext-module deps
# (oplus_bsp_sched_assist, oplus_bsp_frame_boost, cpufreq_bouncing,
# oplus_bsp_task_overload) per kernel/sched/walt/modules.bzl. This is
# its own sub-wave's scope, not batch-2b's. qcom_lpm.ko continues to
# ship from OEM prebuilt; behavioral parity preserved (OEM ships
# qcom_lpm built against OEM's SCHED_WALT, so our shipping their
# prebuilt matches OEM behavior).
# CONFIG_CPU_IDLE_GOV_QCOM_LPM=m  # see batch-2a; Kconfig + Makefile
#                                  # exist in tree but dep is unsatisfied

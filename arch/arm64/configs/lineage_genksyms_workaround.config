# scripts/genksyms (Yacc/Lex parser) crashes with double-free in tcache on
# Arch glibc 2.43 snapshots when fed a large preprocessed input. The crash
# kills any kernel build that has CONFIG_MODVERSIONS=y regardless of host
# compiler (clang and gcc both invoke genksyms via the same recipe). A
# source-built downstream kernel does not need ABI symbol versioning, so we
# disable MODVERSIONS to skip genksyms entirely.
# CONFIG_MODVERSIONS is not set
# CONFIG_ASM_MODVERSIONS is not set

# Oplus extension features whose code lives in `kernel/oneplus/sm8850-modules/
# vendor/oplus/kernel/mm/...` and is normally injected via Kleaf -I paths.
# We're not building those external modules in this Lineage flow, so disable
# the gates to avoid unresolved #include "aizerofs/..." / "mm_boost_pool/..."
# in drivers/dma-buf/heaps.
# CONFIG_OPLUS_FEATURE_AIZEROCOPY is not set
# CONFIG_OPLUS_FEATURE_MM_BOOSTPOOL is not set
# CONFIG_OPLUS_FEATURE_MM_TA_CMA_RSV is not set
# CONFIG_OPLUS_FEATURE_MM_OSVELTE is not set

# Enable USB QDSS gadget function so coresight-tmc-usb's usb_qdss_alloc_req
# 2-arg signature is selected (the #else stub takes 3 args).
CONFIG_USB_F_QDSS=m

# ARCH_QCOM gets dropped by olddefconfig if a previous merge ran against a
# stripped arch/arm64/Kconfig.platforms (vendor's 137-line version had no
# ARCH_QCOM stanza). Pin it here so subsequent merges keep it. Cascades
# CONFIG_ARM_SMMU_QCOM and the QCOM iommu helper bundle (qcom-iommu-helpers.o
# in drivers/iommu/Makefile) on, which arm-smmu.c references unconditionally.
CONFIG_ARCH_QCOM=y

# Disable KASAN. Clang 18+ auto-defines __SANITIZE_ADDRESS__ when -fsanitize=
# address is passed, but compiler-clang.h still does an unconditional manual
# #define and the build hits -Werror,-Wmacro-redefined for every TU. Upstream
# added an #ifndef guard for this; the fix isn't in 6.12. KASAN is a kernel-
# debug feature; not needed for a daily-driver build. Disabling avoids the
# clang/header collision entirely.
# CONFIG_KASAN is not set
# CONFIG_KASAN_GENERIC is not set
# CONFIG_KASAN_INLINE is not set
# CONFIG_KASAN_STACK is not set
# CONFIG_KASAN_VMALLOC is not set

# Vendor stripped the parent `menuconfig SPMI` stanza in drivers/spmi/Kconfig
# (we restored it). Enable the bus framework so spmi_*_register_* symbols are
# linkable when GKI_HIDDEN_REGMAP_CONFIGS forces REGMAP_SPMI on. SPMI_MSM_PMIC_ARB
# auto-defaults to ARCH_QCOM but needs SPMI=y/m as its parent.
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y

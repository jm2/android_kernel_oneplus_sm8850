# MODVERSIONS is required for runtime symbol-version checks against the
# vendor .ko set we keep as binary blobs (all 557 retained vendor modules
# have CRCs in their __versions ELF section). The host-built genksyms
# crashes under glibc 2.43 on real preprocessed input, so scripts/genksyms/
# Makefile is patched to copy a musl-static prebuilt instead of compiling.

# Oplus extension features whose code lives in `kernel/oneplus/sm8850-modules/
# vendor/oplus/kernel/mm/...` and is normally injected via Kleaf -I paths.
# We're not building those external modules in this Lineage flow, so disable
# the gates to avoid unresolved #include "aizerofs/..." / "mm_boost_pool/..."
# in drivers/dma-buf/heaps.
# CONFIG_OPLUS_FEATURE_AIZEROCOPY is not set
# CONFIG_OPLUS_FEATURE_MM_BOOSTPOOL is not set
# CONFIG_OPLUS_FEATURE_MM_TA_CMA_RSV is not set
# CONFIG_OPLUS_FEATURE_MM_OSVELTE is not set

# Enable USB QDSS gadget function so coresight-tmc-usb's usb_qdss_alloc_req
# 2-arg signature is selected (the #else stub takes 3 args).
CONFIG_USB_F_QDSS=m

# ARCH_QCOM gets dropped by olddefconfig if a previous merge ran against a
# stripped arch/arm64/Kconfig.platforms (vendor's 137-line version had no
# ARCH_QCOM stanza). Pin it here so subsequent merges keep it. Cascades
# CONFIG_ARM_SMMU_QCOM and the QCOM iommu helper bundle (qcom-iommu-helpers.o
# in drivers/iommu/Makefile) on, which arm-smmu.c references unconditionally.
CONFIG_ARCH_QCOM=y

# Disable KASAN. Clang 18+ auto-defines __SANITIZE_ADDRESS__ when -fsanitize=
# address is passed, but compiler-clang.h still does an unconditional manual
# #define and the build hits -Werror,-Wmacro-redefined for every TU. Upstream
# added an #ifndef guard for this; the fix isn't in 6.12. KASAN is a kernel-
# debug feature; not needed for a daily-driver build. Disabling avoids the
# clang/header collision entirely.
# CONFIG_KASAN is not set
# CONFIG_KASAN_GENERIC is not set
# CONFIG_KASAN_INLINE is not set
# CONFIG_KASAN_STACK is not set
# CONFIG_KASAN_VMALLOC is not set

# Vendor stripped the parent `menuconfig SPMI` stanza in drivers/spmi/Kconfig
# (we restored it). Enable the bus framework so spmi_*_register_* symbols are
# linkable when GKI_HIDDEN_REGMAP_CONFIGS forces REGMAP_SPMI on. SPMI_MSM_PMIC_ARB
# auto-defaults to ARCH_QCOM but needs SPMI=y/m as its parent.
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y

# Once SPMI is on, qcom-spmi-pmic.ko (a vendor mfd driver) compiles and
# references devm_regmap_qti_debugfs_register from drivers/base/regmap/
# qti-regmap-debugfs.c. The Kconfig stanza for REGMAP_QTI_DEBUGFS exists
# but the Makefile gate was vendor-stripped (now restored). Enable it as a
# module so the symbol is linkable.
CONFIG_REGMAP_QTI_DEBUGFS=m

# QCOM_MINIDUMP_SMEM is bool (not tristate), so it always builds into vmlinux
# when set. Vendor's defconfig has QCOM_MINIDUMP=m, which puts the symbol
# producers (msm_minidump.c, minidump_log.c, minidump_memory.c — all bundled
# in qcom_minidump.ko) outside the in-tree closure that minidump_smem.o is
# part of. Result: msm_minidump_clear_headers / md_num_regions /
# set_section_name unresolved at vmlinux LD. Promote MINIDUMP to =y so the
# producer + consumer end up in the same closure.
CONFIG_QCOM_MINIDUMP=y

# Enable in-tree DRM display helpers — msm_drm.ko (display-drivers/msm)
# imports drm_dp_dpcd_read / drm_dp_dpcd_write / drm_dp_aux_register_* /
# drm_dp_link_rate_to_bw_code / drm_dp_read_lttpr_common_caps from
# drm_display_helper.ko. Upstream the helpers are non-prompted (only
# `select`ed by individual in-tree DRM drivers); we added prompts to
# both DRM_DISPLAY_HELPER and DRM_DISPLAY_DP_HELPER in
# drivers/gpu/drm/display/Kconfig so this defconfig fragment can set
# them.
CONFIG_DRM_DISPLAY_HELPER=m
CONFIG_DRM_DISPLAY_DP_HELPER=y

# wcd_usbss_* exports come from drivers/soc/qcom/wcd939x-i2c.c (bundled
# with wcd-usbss-{regmap,tables,utils}.c into wcd_usbss_i2c.ko per
# vendor's modules.bzl). The Kconfig+Makefile gate is QCOM_WCD_USBSS_I2C
# which we restored from vendor-strip. The display-drivers/msm.ko
# (msm_drm) imports wcd_usbss_reg_notifier / _unreg_notifier /
# _switch_update for DP-over-USB-C analog mux switching.
#
# TYPEC_MUX_WCD939X_USBSS is the typec-side analog-audio mux helper at
# drivers/usb/typec/mux/wcd939x-usbss.c — separate driver, also needed.
CONFIG_TYPEC_MUX_WCD939X_USBSS=m
CONFIG_QCOM_WCD_USBSS_I2C=m

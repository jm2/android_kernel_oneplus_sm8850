# scripts/genksyms (Yacc/Lex parser) crashes with double-free in tcache on
# Arch glibc 2.43 snapshots when fed a large preprocessed input. The crash
# kills any kernel build that has CONFIG_MODVERSIONS=y regardless of host
# compiler (clang and gcc both invoke genksyms via the same recipe). A
# source-built downstream kernel does not need ABI symbol versioning, so we
# disable MODVERSIONS to skip genksyms entirely.
# CONFIG_MODVERSIONS is not set
# CONFIG_ASM_MODVERSIONS is not set

# Oplus extension features whose code lives in `kernel/oneplus/sm8850-modules/
# vendor/oplus/kernel/mm/...` and is normally injected via Kleaf -I paths.
# We're not building those external modules in this Lineage flow, so disable
# the gates to avoid unresolved #include "aizerofs/..." / "mm_boost_pool/..."
# in drivers/dma-buf/heaps.
# CONFIG_OPLUS_FEATURE_AIZEROCOPY is not set
# CONFIG_OPLUS_FEATURE_MM_BOOSTPOOL is not set
# CONFIG_OPLUS_FEATURE_MM_TA_CMA_RSV is not set

# MODVERSIONS is required for runtime symbol-version checks against the
# vendor .ko set we keep as binary blobs (all 557 retained vendor modules
# have CRCs in their __versions ELF section). The host-built genksyms
# crashes under glibc 2.43 on real preprocessed input, so scripts/genksyms/
# Makefile is patched to copy a musl-static prebuilt instead of compiling.

# Phase 1 (Track A) — KMI canonicalization.
# Trim non-KMI symbols from vmlinux so Module.symvers contains only the
# stablelist surface (~4,696 syms) with canonical CRCs that match the
# OEM-built modules' __versions. Without TRIM_UNUSED_KSYMS, our vmlinux
# exports 18,408 syms with CRCs computed over the full struct chain,
# which makes EVERY OEM prebuilt fail CRC validation at modprobe time
# (verified via stgdiff against gki/aarch64/abi.stg in Phase 0.2 — 0
# signature/type breaks, 4,421 pure CRC drifts).
#
# Whitelist file at android/abi_gki_aarch64_oneplus_15 is generated by:
#   { cat gki/aarch64/symbols/* | grep -vE '^\[|^#|^\s*$' | sed 's/^[[:space:]]*//';
#     grep -vE '^#|^\s*$' android/abi_gki_aarch64_oneplus_15_extras;
#   } | sort -u > android/abi_gki_aarch64_oneplus_15
# (~9,083 symbols: full AOSP all-vendor union plus a small Lineage extras
# list for vendor-internal symbols that OEM-built externals depend on but
# AOSP didn't stablelist. Started with base+qcom+oplus = 4,696, but our
# 52 source-built external modules consume KMI-stable symbols on
# pixel/mtk/exynos lists too, plus a few qcom-internal ones not on any
# list. The all-vendor union + extras keeps KMI-strict semantics intact
# while exposing the surface OnePlus's own modules need.)
CONFIG_TRIM_UNUSED_KSYMS=y
CONFIG_UNUSED_KSYMS_WHITELIST="android/abi_gki_aarch64_oneplus_15"

# Oplus extension features whose code lives in `kernel/oneplus/sm8850-modules/
# vendor/oplus/kernel/mm/...` and is normally injected via Kleaf -I paths.
# We're not building those external modules in this Lineage flow, so disable
# the gates to avoid unresolved #include "aizerofs/..." / "mm_boost_pool/..."
# in drivers/dma-buf/heaps.
# CONFIG_OPLUS_FEATURE_AIZEROCOPY is not set
# CONFIG_OPLUS_FEATURE_MM_BOOSTPOOL is not set
# CONFIG_OPLUS_FEATURE_MM_TA_CMA_RSV is not set
# CONFIG_OPLUS_FEATURE_MM_OSVELTE is not set

# Enable USB QDSS gadget function so coresight-tmc-usb's usb_qdss_alloc_req
# 2-arg signature is selected (the #else stub takes 3 args).
CONFIG_USB_F_QDSS=m

# ARCH_QCOM gets dropped by olddefconfig if a previous merge ran against a
# stripped arch/arm64/Kconfig.platforms (vendor's 137-line version had no
# ARCH_QCOM stanza). Pin it here so subsequent merges keep it. Cascades
# CONFIG_ARM_SMMU_QCOM and the QCOM iommu helper bundle (qcom-iommu-helpers.o
# in drivers/iommu/Makefile) on, which arm-smmu.c references unconditionally.
CONFIG_ARCH_QCOM=y

# Keep KASAN_HW_TAGS but disable KASAN_GENERIC. The clang 18+ macro-redef
# issue is specifically with -fsanitize=address (KASAN_GENERIC); HW tags
# uses -fsanitize=hwaddress and doesn't hit the compiler-clang.h
# unconditional #define. Many vendor prebuilts (qca_cld3_*, oplus_bsp_*,
# qcom_dma_heaps, qcom_iommu_util, msm_kgsl etc.) reference
# kasan_flag_enabled which lives in mm/kasan/hw_tags.c.
CONFIG_KASAN=y
CONFIG_KASAN_HW_TAGS=y
# CONFIG_KASAN_GENERIC is not set
# CONFIG_KASAN_INLINE is not set
# CONFIG_KASAN_STACK is not set
# CONFIG_KASAN_VMALLOC is not set

# Vendor stripped the parent `menuconfig SPMI` stanza in drivers/spmi/Kconfig
# (we restored it). Enable the bus framework so spmi_*_register_* symbols are
# linkable when GKI_HIDDEN_REGMAP_CONFIGS forces REGMAP_SPMI on. SPMI_MSM_PMIC_ARB
# auto-defaults to ARCH_QCOM but needs SPMI=y/m as its parent.
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y

# Once SPMI is on, qcom-spmi-pmic.ko (a vendor mfd driver) compiles and
# references devm_regmap_qti_debugfs_register from drivers/base/regmap/
# qti-regmap-debugfs.c. The Kconfig stanza for REGMAP_QTI_DEBUGFS exists
# but the Makefile gate was vendor-stripped (now restored). Enable it as a
# module so the symbol is linkable.
CONFIG_REGMAP_QTI_DEBUGFS=m

# QCOM_MINIDUMP=m. We previously promoted to =y to escape an in-tree
# minidump_smem reference cascade, but that pulled msm_minidump.c into
# vmlinux which then required qcom_smem/qcom_dma_heap/mem_buf to also
# be =y — a chain that eventually reaches external modules. Keep =m
# and disable QCOM_MINIDUMP_SMEM (the bool that started this) so nothing
# outside qcom_minidump.ko references those symbols.
CONFIG_QCOM_MINIDUMP=m
# CONFIG_QCOM_MINIDUMP_SMEM is not set

# Enable in-tree DRM display helpers — msm_drm.ko (display-drivers/msm)
# imports drm_dp_dpcd_read / drm_dp_dpcd_write / drm_dp_aux_register_* /
# drm_dp_link_rate_to_bw_code / drm_dp_read_lttpr_common_caps from
# drm_display_helper.ko. Upstream the helpers are non-prompted (only
# `select`ed by individual in-tree DRM drivers); we added prompts to
# both DRM_DISPLAY_HELPER and DRM_DISPLAY_DP_HELPER in
# drivers/gpu/drm/display/Kconfig so this defconfig fragment can set
# them.
CONFIG_DRM_DISPLAY_HELPER=m
CONFIG_DRM_DISPLAY_DP_HELPER=y

# wcd_usbss_* exports come from drivers/soc/qcom/wcd939x-i2c.c (bundled
# with wcd-usbss-{regmap,tables,utils}.c into wcd_usbss_i2c.ko per
# vendor's modules.bzl). The Kconfig+Makefile gate is QCOM_WCD_USBSS_I2C
# which we restored from vendor-strip. The display-drivers/msm.ko
# (msm_drm) imports wcd_usbss_reg_notifier / _unreg_notifier /
# _switch_update for DP-over-USB-C analog mux switching.
#
# TYPEC_MUX_WCD939X_USBSS is the typec-side analog-audio mux helper at
# drivers/usb/typec/mux/wcd939x-usbss.c — separate driver, also needed.
CONFIG_TYPEC_MUX_WCD939X_USBSS=m
CONFIG_QCOM_WCD_USBSS_I2C=m

# Phase A — kernel framework Kconfig restoration
# ------------------------------------------------------------------
# Vendor stripped `config RPMSG`/`REMOTEPROC`/`GUNYAH`/`ARM_SCMI_PROTOCOL`/
# `QCOM_SMEM_STATE`/`INTERCONNECT_QCOM` from their respective Kconfig files
# (Kleaf forces compile via module_outs, plain mka kernel silently dropped
# the obj-$(CONFIG_X) entries). We restored the stanzas; now pin the
# resulting configs so they stick across olddefconfig runs and so the
# resulting Module.symvers contains the symbols that vendor prebuilts
# (~46 of the 110 unresolved depmod symbols) consume.
#
# Resolves: rpmsg_*, rproc_*, devm_rproc_*, gunyah_*, scmi_*,
# qcom_smem_state_*, qcom_icc_xlate_extended.

CONFIG_RPMSG=m
CONFIG_RPMSG_CTRL=y
CONFIG_RPMSG_NS=y
# RPMSG_CHAR=y is already in gki_defconfig.
# REMOTEPROC=y, REMOTEPROC_CDEV=y, GUNYAH=y, GUNYAH_QCOM_TRUSTED_VM=y,
# ARM_SCMI_PROTOCOL=y are already in gki_defconfig — they'll stick now
# that the Kconfig stanzas exist.
CONFIG_GUNYAH_HYPERCALLS=y
CONFIG_GUNYAH_PLATFORM_HOOKS=y
# gh_arm_drv.ko bundles arch-specific gunyah arm64 (gh_arm.c+irq.c+reset.c).
# Listed in modules.list.msm.canoe and load.recovery, so it must build.
CONFIG_GH_ARM64_DRV=m
# Restored Kconfig — drivers/ufs/host/Kconfig: SCSI_UFS_CRYPTO_QTI gates
# the qcom_ice_program_key_hwkm export inside drivers/soc/qcom/ice.c. The
# OEM prebuilt ufshcd-crypto-qti.ko consumes it. Pin =m so the export
# materializes; we don't need the .ko to be source-built (the OEM
# prebuilt is fine since CRC will match once qcom_ice exports the symbol).
CONFIG_SCSI_UFS_CRYPTO_QTI=m
CONFIG_QCOM_SMEM_STATE=y
CONFIG_INTERCONNECT_QCOM=m
# qcom_ramdump.ko provides qcom_create/destroy_ramdump_device — consumed
# by qcom_q6v5_pas.ko. Vendor-stripped Makefile entry restored above.
CONFIG_QCOM_RAMDUMP=m
# mem-prot.ko provides mem_prot_pool_alloc/free for gh_rm_heap_manager.ko.
CONFIG_MEM_PROT=m
# icc-debug.ko provides qcom_icc_debug_register/unregister for icc-rpmh.ko.
CONFIG_INTERCONNECT_QCOM_DEBUG=m
# Phase D: altmode-glink.ko + panel_event_notifier.ko consumed by msm_drm.ko
# (source-built display-drivers/msm). Vendor-stripped Kconfig+Makefile
# entries restored above.
CONFIG_QTI_PMIC_GLINK=m
CONFIG_QTI_ALTMODE_GLINK=m
CONFIG_QCOM_PANEL_EVENT_NOTIFIER=m
# Phase D: oplus device_info (note vendor's typo IFNO not INFO) and
# touchpanel_event_notify modules — consumed by msm_drm.ko via Phase D's
# oplus extension wiring. Built as :kbuild external modules.
CONFIG_OPLUS_DEVICE_IFNO=m
CONFIG_TOUCHPANEL_NOTIFY=m

# QCOM_MINIDUMP=y (set above) puts msm_minidump.c into vmlinux. It
# references qcom_smem_get (smem.c) / debug_symbol_lookup_name
# (debug_symbol.c) / qcom_is_dma_buf_file (qcom_dma_heap.c). Promote
# their providers to =y so they end up in the same vmlinux closure.
# With QCOM_MINIDUMP=m above, these promotions are no longer needed:
# QCOM_SMEM/DEBUG_SYMBOL/DMABUF_HEAPS can stay as modules, since
# qcom_minidump.ko (also =m) can resolve them at modprobe time.
# CONFIG_QCOM_SMEM stays =m (gki_defconfig)
# CONFIG_QCOM_DEBUG_SYMBOL stays =m (gki_defconfig)
# CONFIG_QCOM_DMABUF_HEAPS stays =m (gki_defconfig)

# Phase 5 wave 2 sub-wave 2A — canoe clock cluster.
# Source files at drivers/clk/qcom/{gcc,dispcc,camcc}-canoe.c are
# orphaned in our tree (Kconfig stanzas + Makefile entries restored
# in this fork). The canoe DT consumes <&gcc>, <&dispcc>, <&camcc>
# phandles directly; without these, kernel boots with no canoe clock
# tree and any device that clk_get()'s a canoe clock fails. MVB-blocking.
# All three as =m so they ship as .ko in vendor_dlkm and load via
# coldboot's DT compatible match.
CONFIG_SM_GCC_CANOE=m
CONFIG_SM_DISPCC_CANOE=m
CONFIG_SM_CAMCC_CANOE=m
